{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"],
    "noEmit": true
  },
  "include": ["src/*.ts", "webview/*.ts", "webview/*.tsx", "preview/*.ts", "preview/*.tsx", "../protocol.ts"]
}
