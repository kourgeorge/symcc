{
  "name": "symcc-cursor",
  "displayName": "symcc",
  "description": "Run a team of coding agents from one chat: the symcc board and its lead, inside Cursor",
  "version": "0.1.0",
  "publisher": "symcc",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "symcc",
          "title": "symcc",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "symcc": [
        {
          "type": "webview",
          "id": "symcc.side",
          "name": "Board",
          "icon": "media/activity.svg",
          "contextualTitle": "symcc"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "symcc.message",
          "when": "view == symcc.side",
          "group": "navigation@1"
        },
        {
          "command": "symcc.open",
          "when": "view == symcc.side",
          "group": "navigation@2"
        },
        {
          "command": "symcc.restart",
          "when": "view == symcc.side",
          "group": "engine@1"
        },
        {
          "command": "symcc.showLog",
          "when": "view == symcc.side",
          "group": "engine@2"
        }
      ]
    },
    "commands": [
      {
        "command": "symcc.open",
        "title": "Open the board",
        "category": "symcc",
        "icon": "$(link-external)"
      },
      {
        "command": "symcc.message",
        "title": "Message the lead",
        "category": "symcc",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "symcc.init",
        "title": "Set up symcc in this project",
        "category": "symcc"
      },
      {
        "command": "symcc.restart",
        "title": "Restart the engine",
        "category": "symcc"
      },
      {
        "command": "symcc.showLog",
        "title": "Show the engine log",
        "category": "symcc"
      }
    ],
    "configuration": {
      "title": "symcc",
      "properties": {
        "symcc.agents": {
          "type": "string",
          "default": "cursor",
          "markdownDescription": "Whose agents run the lead chat and the workers, for example `cursor` or `copilot`. The board's model menu lists the ones your symcc knows. Changing it restarts symcc: running workers stop and their tasks go back to the board."
        },
        "symcc.leadModel": {
          "type": "string",
          "default": "",
          "description": "The model the lead chat runs on (empty: the default of the agents in use, Composer 2.5 on Cursor, Auto on Copilot)."
        },
        "symcc.workerModel": {
          "type": "string",
          "default": "",
          "description": "The model for workers whose role names none (empty: the default of the agents in use, Composer 2.5 on Cursor, Auto on Copilot)."
        },
        "symcc.enginePath": {
          "type": "string",
          "default": "",
          "description": "The engine to run (empty: the one next to this extension, hosts/cursor/dist/engine.mjs)."
        },
        "symcc.nodePath": {
          "type": "string",
          "default": "",
          "description": "The Node.js to run the engine with (empty: the editor's own)."
        },
        "symcc.proxy": {
          "type": "string",
          "default": "",
          "description": "The proxy the engine reaches Cursor through, e.g. http://proxy.example.com:912 (empty: the editor's http.proxy setting, then HTTPS_PROXY)."
        },
        "symcc.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when something new needs you while the board is not in view."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.38",
    "@vscode/codicons": "0.0.36",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/vscode": "1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3"
  }
}
